# PostgreSQL connection string from Neon or another PostgreSQL provider
ORDERS_ENABLED=false
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# BotFather token and Telegram webhook verification secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Telegram group where administrators receive and manage orders
TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated Telegram user IDs allowed to use admin buttons and /orders
TELEGRAM_ADMIN_IDS=
# Optional courier list, e.g. [{"id":"123456789","name":"Іван"}]
TELEGRAM_COURIERS=[]

# Public HTTPS origin used by the Telegram Mini App and canonical URLs
SITE_URL=https://your-domain.example
